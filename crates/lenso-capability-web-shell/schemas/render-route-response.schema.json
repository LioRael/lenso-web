{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["contribution_id", "body", "navigation", "asset_paths", "requirements"],
  "properties": {
    "contribution_id": {"type": "string"},
    "body": {"type": "string"},
    "navigation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["route", "label"],
        "properties": {"route": {"type": "string"}, "label": {"type": "string"}},
        "additionalProperties": false
      }
    },
    "asset_paths": {"type": "array", "items": {"type": "string"}},
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability_id", "descriptor_version", "operations"],
        "properties": {
          "capability_id": {"type": "string"},
          "descriptor_version": {"type": "string"},
          "operations": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
