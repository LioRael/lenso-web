{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bind_address": {
      "type": "string"
    },
    "max_request_body_bytes": {
      "type": "integer"
    },
    "max_request_head_bytes": {
      "type": "integer"
    },
    "max_concurrent_requests": {
      "type": "integer"
    },
    "max_connections": {
      "type": "integer"
    },
    "request_head_timeout_millis": {
      "type": "integer"
    },
    "request_body_timeout_millis": {
      "type": "integer"
    },
    "connection_idle_timeout_millis": {
      "type": "integer"
    },
    "shutdown_grace_timeout_millis": {
      "type": "integer"
    },
    "request_timeout_millis": {
      "type": "integer"
    },
    "session_cookie": {
      "type": "object",
      "required": ["name", "csrf_cookie_name", "csrf_header_name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^__Host-[!#$%&'*+.^_`|~0-9A-Za-z-]*$"
        },
        "csrf_cookie_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^__Host-[!#$%&'*+.^_`|~0-9A-Za-z-]*$"
        },
        "csrf_header_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
